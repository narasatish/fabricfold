# ── Database ─────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Supabase, free tier): create a project at supabase.com, then
# Settings -> Database -> Connection string (URI) and ALSO change
# prisma/schema.prisma datasource provider to "postgresql" + install
# @prisma/adapter-pg and swap the adapter in lib/db.ts (see README).
# DATABASE_URL="postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres"

# ── Auth ─────────────────────────────────────────────────
AUTH_SECRET="change-me-64-random-chars"
# Dev-only: every OTP is this value and is printed to the server console.
DEV_OTP="123456"

# ── Supabase Storage (expense receipts) ──────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="receipts"

# ── Razorpay (auto payment confirmation) ─────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Web Push (generate with: npx tsx scripts/vapid.ts) ───
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@fabricfold.in"

# ── Vercel Cron auth for /api/report/daily ───────────────
CRON_SECRET=""
