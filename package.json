{
  "name": "fabricfold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "prisma generate && node scripts/deploy-migrate.mjs && node scripts/ensure-guards.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "verify": "node scripts/verify-all.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "mysql2": "^3.24.3",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.65.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "next": "^16.2.12",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
