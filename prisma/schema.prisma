// FabricFold — schema approved by owner (see docs/handoff README)
// NOTE: "enum" fields are strings validated by zod at the API boundary so the
// same schema runs on SQLite (local dev) and Postgres/Supabase (production).
// Switch = change datasource provider + DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Org ─────────────
model College {
  id            String       @id @default(cuid())
  name          String
  address       String       @default("")
  active        Boolean      @default(true)
  closedWeekday Int? // this college's fixed weekly holiday, 0=Sun..6=Sat; null = none
  features      Json // per-college flags: svc_wash, svc_iron, svc_dryclean, svc_washfold, subscriptions, credits, express, chat
  rates         Json? // per-college item rates override; null = use global AppConfig.rates. {washIron:{label,items:[[name,price],...]}, washFold:..., ironOnly:..., dryClean:...}
  expressRates  Json? // per-college express (same-day) flat-fee override; null = use global EXPRESS_FLAT. {washFold: 80, washIron: 120, ...} — per-key, missing services fall back to global
  students      Student[]
  staff         Staff[]
  orders        Order[]
  plans         Plan[]
  slots         SlotWindow[]
}

/**
 * A recurring weekly drop-off window for one campus, e.g. Mon 09:00–11:00 cap 15.
 * Students book a concrete date against one of these; capacity caps how many
 * orders may be dropped in that window so the counter queue stays spread.
 */
model SlotWindow {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Sun .. 6=Sat (IST)
  startMin  Int // minutes from midnight IST, e.g. 540 = 09:00
  endMin    Int // e.g. 660 = 11:00
  capacity  Int      @default(15)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([collegeId, weekday, active])
}

// Subscription plan offered by ONE college. A plan bundles one or more
// "buckets" — e.g. St Mary's ₹5,000 plan = 20 Wash&Fold + 14 Wash&Iron cycles.
model Plan {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  name      String
  tier      String? // bronze | silver | gold — drives the bag code letter (B/S/G). null = untiered legacy plan
  price     Decimal // base price; GST added on top unless gstFree
  gstFree   Boolean  @default(false) // e.g. BVRIT ₹7,000 flat, no GST
  active    Boolean  @default(true)
  buckets   Json // [{service:"washFold"|"washIron"|..., cycles:20, kgPerCycle:7}]
  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@index([collegeId, active])
}

model Student {
  id             String   @id // human FabricFold code (6 digits) — shown on card/QR
  phone          String   @unique
  name           String
  /**
   * "student" | "faculty" (Sep 2026). Faculty use the same app, same orders,
   * same tracking — the difference is commercial: they buy flexible cycle
   * PACKS (N cycles at the per-cycle rate) instead of tiered plans, and their
   * bags carry the F series. A field, not a table: everything else is shared.
   */
  kind           String   @default("student")
  collegeId      String
  college        College  @relation(fields: [collegeId], references: [id])
  credits        Decimal  @default(0)
  lifetimePieces Int      @default(0)
  washDay        Int? // assigned weekly drop-off day, 0=Sun..6=Sat; spreads load evenly across the week (soft guidance, not enforced)
  createdAt      DateTime @default(now())

  /**
   * Optional passcode, so a student who has signed in once by OTP can get back
   * in without waiting for a text — useful on a campus with poor signal.
   * NEVER the passcode itself: scrypt hash + per-user salt. OTP remains the way
   * to RESET it, because the phone is the thing we can actually verify.
   * Failures are counted and the account locks briefly, otherwise a 4-6 digit
   * passcode is trivially brute-forced.
   */
  passwordHash     String?
  passwordSalt     String?
  passwordSetAt    DateTime?
  pwFailedAttempts Int       @default(0)
  pwLockedUntil    DateTime?

  /**
   * Bumped to revoke every existing session at once. A JWT cannot be recalled
   * once issued, so without this a lost phone stays signed in for up to 30
   * days — "sign out everywhere" would be a button that does nothing. The
   * epoch is carried in the token and compared on each authenticated request,
   * which costs nothing extra because that request already loads this row.
   */
  sessionEpoch Int @default(0)

  /**
   * Erasure request. The financial ledger is immutable by law and by trigger,
   * so a student's orders and payments cannot be deleted — what CAN go is
   * everything identifying them: name, phone, notification history. The rows
   * stay so the accounts still balance, but they no longer name a person.
   * Recorded rather than silent, because an erasure must itself be auditable.
   */
  anonymisedAt DateTime?

  subscription  Subscription?
  orders        Order[]
  payments      Payment[]
  creditUses    CreditUse[]
  compensations Compensation[]
  complaints    Complaint[]
  notifications Notification[]
  bags          Bag[]

  /**
   * Student had NO indexes at all. Every campus filter was a sequential scan,
   * and the students list orders by createdAt on every load. Cheap to add,
   * and the cost only grows.
   */
  @@index([collegeId])
  @@index([createdAt])
}

model Staff {
  id         String       @id @default(cuid())
  phone      String       @unique
  name       String
  role       Int // 1 Counter · 2 Manager · 3 Admin · 4 Owner (server-enforced)
  collegeId  String?
  college    College?     @relation(fields: [collegeId], references: [id])
  payslips   Payslip[]
  attendance Attendance[]

  /**
   * Removing a staff member DEACTIVATES rather than deletes.
   * They own payslips and attendance rows, and their id appears against every
   * payment they took and every audit entry they caused. A hard delete would
   * either fail on those references or erase the record of who handled the
   * money — which is exactly the record you need after someone leaves.
   */
  active Boolean @default(true)

  // Same revocation mechanism as Student — see the note there. Matters more
  // here: a staff session can take payments and issue refunds.
  sessionEpoch Int @default(0)

  /**
   * Per-person overrides on top of the role's defaults (Sep 2026): the owner
   * grants or revokes named tools — money reports, refunds, day close —
   * without inventing a new role for every trust decision. {"reports": true}
   * grants; {"reports": false} revokes; absent = the role decides. Owners are
   * exempt from revocation: a control panel that can lock out its own owner
   * is a footgun, not a feature.
   */
  perms Json?
}

// ───────────── Subscription (cycle-based) ─────────────
model Subscription {
  id          String     @id @default(cuid())
  studentId   String     @unique
  student     Student    @relation(fields: [studentId], references: [id])
  active      Boolean    @default(false) // false = pending Manager+ approval
  plan        String // plan name snapshot
  planId      String?
  planRef     Plan?      @relation(fields: [planId], references: [id])
  buckets     Json? // usage snapshot: [{service, cycles, used, kgPerCycle}]
  startedAt   DateTime?
  expiresAt   DateTime?
  cyclesTotal Int // sum across buckets (kept for dashboards/legacy)
  cyclesUsed  Int        @default(0)
  kgPerCycle  Decimal
  cycleLog    CycleUse[]

  // Cancellation is recorded, never erased. A plan that simply went inactive
  // with no reason is indistinguishable from a bug, and the student is owed an
  // explanation months later just as much as today.
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     String? // staffId
}

// A PHYSICAL bag handed to a student, with its code printed on the outside:
// B001–B999 bronze · S001–S999 silver · G001–G999 gold · W001–W999 walk-in
// (no subscription). The first bag is complimentary; replacements are sold.
//
// Codes are allocated gap-free and NEVER reused — a reissued code would make an
// already-printed bag point at two different students over its lifetime. A lost
// bag is marked lost and the student gets a NEW code, not the old one back.
model Bag {
  id String @id @default(cuid())

  /**
   * NOT globally unique any more — unique only among codes still IN SERVICE.
   * A code is the student's customer ID printed on the bag, and it is recycled
   * when they graduate, so B001 legitimately appears on several Bag rows across
   * the years. The guarantee that still matters — one code never points at two
   * students at the same time — is enforced by a partial unique index created
   * in scripts/ensure-guards.mjs:  UNIQUE(code) WHERE status <> 'released'.
   * Prisma cannot express a partial unique index, hence the raw one.
   */
  code          String
  studentId     String
  student       Student @relation(fields: [studentId], references: [id])
  tier          String? // bronze | silver | gold | null (walk-in)
  complimentary Boolean @default(false) // first bag free, later ones charged
  price         Decimal @default(0)

  /**
   * active | lost | replaced | released
   * Only `released` frees the code for a new student. A lost bag keeps its
   * code reserved: bags turn up weeks later, and it must still identify the
   * person it was issued to rather than whoever inherited the number.
   */
  status     String    @default("active")
  releasedAt DateTime?
  issuedAt   DateTime  @default(now())
  issuedBy   String // staffId
  note       String?

  @@index([studentId, status])
  @@index([code])
}

/**
 * Rows waiting to reach the Google Sheet.
 * A transactional outbox. The event is written in the SAME transaction as the
 * order or payment that caused it, so the Sheet can never miss something that
 * really happened — and, just as important, can never record something that
 * was rolled back. Delivery is separate and best-effort: Google being slow or
 * down must never make an order fail at the counter.
 * Rows are kept briefly after sending so a sync can be proved rather than
 * assumed; the cron prunes them.
 */
model SheetOutbox {
  id      String   @id @default(cuid())
  kind    String // order | payment | complaint | collection
  at      DateTime @default(now())
  payload Json // the finished row, resolved at enqueue time

  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?

  // the flush scans exactly this: unsent, oldest first
  @@index([sentAt, at])
}

model CycleUse {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  orderId        String
  at             DateTime     @default(now())
}

// ───────────── Orders ─────────────
model Order {
  id String @id // human order code (#tag, last 4/6 shown)

  /**
   * Client-generated key for an order captured while the counter was OFFLINE.
   * The queued intake is replayed when the connection returns, and a replay
   * can happen twice — the tab reconnects, the staff member also taps retry,
   * the request times out after the server already committed. This key is what
   * makes a repeat harmless: a partial unique index (ensure-guards) rejects the
   * second insert, and walkInOrder returns the order that already exists
   * instead of taking the clothes in twice. Null for anything taken online.
   */
  idemKey String?

  studentId               String
  student                 Student   @relation(fields: [studentId], references: [id])
  collegeId               String
  college                 College   @relation(fields: [collegeId], references: [id])
  service                 String // wash | iron | dryclean
  items                   Json // [{label, qty, price}] snapshot at order time
  declaredPieces          Int       @default(0)
  actualPieces            Int?
  weightKg                Decimal?
  express                 Boolean   @default(false)
  surcharge               Decimal   @default(0)
  status                  String    @default("draft") // draft|received|processing|ready|collected|cancelled
  subtotal                Decimal // GST-INCLUSIVE pricing
  gst                     Decimal // tax component of total at gstPctSnapshot
  gstPctSnapshot          Decimal
  total                   Decimal
  paid                    Boolean   @default(false)
  paymentMethod           String? // upi | cash | credit | upi+credit | cash+credit | redo
  creditApplied           Decimal   @default(0)
  usedCycle               Boolean   @default(false)
  /**
   * How many cycles this order burns (Sep 2026, cycle-basis billing). A 9 kg
   * bag may deliberately use two cycles — the student's choice — and the
   * 5 kg allowance scales with it. 1 for every order that predates the rule.
   */
  cyclesCount             Int       @default(1)
  noGst                   Boolean   @default(false) // staff chose to bill without GST at accept; never invoiced
  redoOfId                String?
  refunded                Boolean   @default(false)
  refundAmount            Decimal?
  rating                  Int?
  ratingComment           String?
  ratedAt                 DateTime?
  intakePhotos            Json? // storage keys of photos taken at drop-off (pre-existing damage)
  dropSlotAt              DateTime? // booked drop-off window START (null = no slot booked)
  dropSlotEndAt           DateTime? // booked drop-off window END
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  receivedAt              DateTime? // SLA: due = receivedAt + (express ? 1 : 2) days
  // How many "please collect" nudges have gone out for this order. Counting
  // them (rather than a bool) is what stops the daily cron re-sending the same
  // reminder every run while a bag sits uncollected for a fortnight.
  collectionRemindersSent Int       @default(0)

  timeline OrderEvent[]
  tags     GarmentTag[]
  payments Payment[]
  invoice  Invoice?

  @@index([studentId])
  @@index([collegeId, status])
  @@index([collegeId, dropSlotAt]) // slot capacity counts + staff slot board
}

model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id])
  status  String // placed|received|processing|ready|collected|cancelled
  at      DateTime @default(now())
}

model GarmentTag {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id])
  code    String  @unique // <order6>-NN
  label   String
  scanned Boolean @default(false)
}

// ───────────── Money ─────────────
model Payment {
  id         String   @id @default(cuid())
  method     String // cash | upi | credit | cash_out | refund
  amount     Decimal // negative for cash_out / refund
  at         DateTime @default(now())
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  collegeId  String
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  note       String?
  refundVia  String? // upi | cash | credit (when method = refund)
  gatewayRef String? // Razorpay payment id when auto-captured

  @@index([collegeId, at])
  /**
   * The reports page filters on `at` alone (8-week revenue bars). The
   * composite above leads with collegeId, so it cannot serve that query.
   */
  @@index([at])
}

model Invoice {
  id          String       @id @default(cuid())
  number      String       @unique // INV-<FY>-0001 (Indian FY, April start)
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id])
  studentId   String
  collegeId   String
  subtotal    Decimal
  gst         Decimal
  gstPct      Decimal
  total       Decimal
  method      String
  at          DateTime     @default(now())
  creditNotes CreditNote[]
}

model CreditNote {
  id        String   @id @default(cuid())
  number    String   @unique // CN-<FY>-0001
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  orderId   String
  studentId String
  collegeId String
  subtotal  Decimal
  gst       Decimal
  total     Decimal
  at        DateTime @default(now())
  reason    String
  by        String // staffId
  via       String // upi | cash | credit
}

model FySequence {
  kind  String // invoice | credit_note | payslip
  fyTag String // e.g. "2627" or "YYYYMM" for payslips
  value Int    @default(0)

  @@id([kind, fyTag])
}

model CreditUse {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  orderId   String
  amount    Decimal
  at        DateTime @default(now())
}

model Compensation {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  orderId     String?
  complaintId String? // set when this payout settles a specific complaint
  kind        String // damage | stain | missing | goodwill | manual
  amount      Decimal
  method      String // credit | cash (cash = Manager+, posts cash_out)
  comment     String?
  by          String // staffId
  at          DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Decimal
  note        String?
  method      String // cash | upi
  by          String // staffId (Manager+)
  collegeId   String
  at          DateTime @default(now())
  receiptKey  String? // storage object key (photo/PDF)
  receiptMime String?
}

// ───────────── Payroll (Admin+) ─────────────
model Payslip {
  id         String   @id @default(cuid())
  number     String   @unique // PS-YYYYMM-NNN
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  month      String // YYYY-MM
  basic      Decimal
  allowances Decimal  @default(0)
  deductions Decimal  @default(0)
  net        Decimal
  expenseId  String?  @unique // auto-posted "Salaries" expense
  at         DateTime @default(now())
}

// ───────────── Support / comms ─────────────
model Complaint {
  id          String             @id @default(cuid())
  orderId     String?
  collegeId   String             @default("")
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id])
  text        String
  status      String             @default("open") // open | resolved
  at          DateTime           @default(now())
  resolvedAt  DateTime?
  // Remedies granted for this complaint, so a free re-wash or a payout is
  // always traceable back to the grievance that caused it (and reportable).
  redoOrderId String? // the free re-service order raised for this complaint
  messages    ComplaintMessage[]
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  from        String // student | staff
  by          String
  text        String
  photos      Json? // storage keys of attached photos (e.g. pre-wash damage evidence)
  at          DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  text      String
  kind      String   @default("status") // ready | status | credit | ...
  read      Boolean  @default(false)
  at        DateTime @default(now())
}

// ───────────── Attendance (staff clock in/out) ─────────────
model Attendance {
  id       String    @id @default(cuid())
  staffId  String
  staff    Staff     @relation(fields: [staffId], references: [id])
  date     String // YYYY-MM-DD (IST business day)
  clockIn  DateTime  @default(now())
  clockOut DateTime?

  @@unique([staffId, date])
  @@index([date])
}

// ───────────── Day close (cash drawer reconciliation ritual) ─────────────
model DayClose {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD
  expectedCash Decimal // computed by the app at close time
  countedCash  Decimal // physically counted by staff
  variance     Decimal // counted − expected (≠0 is investigated)
  note         String?
  by           String // staffId
  at           DateTime @default(now())
}

model AuditLog {
  id     String   @id @default(cuid())
  action String
  detail String
  by     String // staffId
  at     DateTime @default(now())
}

// Self-reported errors (client + server) so the owner learns of crashes.
model ErrorLog {
  id      String   @id @default(cuid())
  kind    String // client | server
  message String
  stack   String?
  url     String?
  who     String? // student/staff id if known
  seen    Boolean  @default(false)
  at      DateTime @default(now())

  @@index([at])
}

/**
 * Fixed-window rate limiting, keyed by whatever the caller chooses (an IP, a
 * phone, a pair of both).
 * Kept in the database rather than memory because serverless functions do not
 * share memory — an in-process counter resets on every cold start and each
 * instance counts separately, which is no limit at all.
 */
model RateLimit {
  key         String   @id // e.g. "otp:ip:1.2.3.4"
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

model Otp {
  id        String    @id @default(cuid())
  phone     String
  purpose   String // login | pickup | subscription
  code      String
  refId     String?
  attempts  Int       @default(0) // wrong tries; OTP dies after 5
  expiresAt DateTime
  usedAt    DateTime?

  @@index([phone, purpose])
}

model PushSubscription {
  id       String @id @default(cuid())
  userKind String // student | staff
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String
}

// ───────────── Config (singleton row, id = "main") ─────────────
model AppConfig {
  id       String  @id @default("main")
  gstPct   Decimal
  plan     Json // {price, cycles, kgPerCycle}
  rates    Json // {washIron:{label,items:[[name,price],...]}, ironOnly:..., dryClean:...}
  payment  Json // {upiId, payeeName, bankName, accountName, accountNo, ifsc, gatewayKey}
  settings Json // {reportEmail, dailyEmail, sendHour, lastSent, openingFloat}
}

/**
 * ───────────── WhatsApp sign-in ─────────────
 * Verification runs BACKWARDS compared with an OTP: the student sends us a
 * code rather than receiving one. Meta gates AUTHENTICATION templates behind
 * 2,000 unique recipients, which one campus never reaches — but that gate is
 * only on business-initiated messages. A message the student sends needs no
 * template at all, and Meta's delivery to our webhook carries their verified
 * number, which is the thing an OTP was proving anyway.
 */
model WaVerify {
  id        String @id @default(cuid())
  /**
   * Goes in the pre-filled WhatsApp message, so the student can read it and
   * so can anyone looking over their shoulder. It identifies the attempt; it
   * does NOT authorise it — see claimHash.
   */
  code      String @unique
  /**
   * sha256 of a secret held only in this browser's httpOnly cookie. The code
   * travels through WhatsApp in clear text, so it cannot be the only thing
   * standing between an onlooker and a session. Hashed rather than stored raw
   * so a database leak still can't claim anyone's pending sign-in.
   */
  claimHash String

  status    String  @default("pending") // pending | verified | failed | claimed
  /**
   * Which door this attempt opens: "customer", "staff", or "register" (Oct 2026).
   * - "customer": sign in an existing student
   * - "staff": sign in staff
   * - "register": create a new student account (BVRIT self-registration)
   * The webhook checks the matching table, and the claim mints the matching
   * session; a student can never ride a staff attempt in, or vice versa.
   */
  mode      String  @default("customer")
  phone     String? // filled from Meta's payload — this is the VERIFIED number
  studentId String? // the matched account id — a Student id or a Staff id, per mode
  collegeId String? // for "register" mode, which college this registration is for
  reason    String? // why it failed, in words the student can act on

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([status, expiresAt])
}
